{
  "manifest_version": 3,
  "name": "Archivéo — compteur de résultats",
  "version": "0.1.2",
  "description": "Depuis le site Archivéo, ouvre les bases d'archives pertinentes dans votre navigateur (avec vos sessions) et rapporte le nombre de résultats.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Archivéo" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
